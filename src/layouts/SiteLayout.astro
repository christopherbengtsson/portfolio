---
import '../styles/site.css';
import LampThemeToggle from '../components/astro/LampThemeToggle.astro';
import type { WebHome } from '../content.config';
import { absolute, email, homePath, otherLocale, origin, privacyPath, profiles, type Locale } from '../lib/site';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  content: WebHome;
  page?: 'home' | 'privacy';
}

const { locale, title, description, content: t, page = 'home' } = Astro.props;
const pagePath = page === 'privacy' ? privacyPath : homePath;
const canonical = absolute(pagePath(locale));
const socialImage = absolute(`/og-${locale}.png`);
const socialImageAlt = locale === 'sv'
  ? 'Mörkt CB-monogram på en ljus kvadrat, en tunn grå linje och texten Christopher Bengtsson – Konsult inom systemutveckling på vit bakgrund.'
  : 'Dark CB monogram on a pale square, a thin gray line, and the text Christopher Bengtsson – Software engineering consultancy on a white background.';
const sectionPrefix = page === 'home' ? '' : homePath(locale);
const person = {
  '@context': 'https://schema.org', '@type': 'Person', '@id': `${origin}/#person`,
  name: 'Christopher Bengtsson', url: origin, email,
  jobTitle: t.eyebrow,
  sameAs: profiles.map((profile) => profile.url),
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Örebro University' },
  knowsAbout: ['Full-stack software engineering', 'System integrations', 'Software maintenance', 'Workflow automation', 'Technical review'],
};
const website = {
  '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${origin}/#website`,
  name: 'Christopher Bengtsson', url: origin, inLanguage: ['en', 'sv'],
  publisher: { '@id': `${origin}/#person` },
};
const json = (value: object) => JSON.stringify(value).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (() => {
        let saved;
        try { saved = localStorage.getItem('theme'); } catch { /* Storage can be unavailable. */ }
        const systemDark = matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = saved === 'dark' || saved === 'light' ? saved : systemDark ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {page === 'privacy' && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale} href={canonical} />
    <link rel="alternate" hreflang={otherLocale(locale)} href={absolute(pagePath(otherLocale(locale)))} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Christopher Bengtsson" />
    <meta property="og:locale" content={locale === 'sv' ? 'sv_SE' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <script type="application/ld+json" set:html={json(person)} />
    <script type="application/ld+json" set:html={json(website)} />
  </head>
  <body class="landing-body">
    <a class="skip-link" href="#main">{t.skip}</a>
    <header class="landing-header">
      <div class="landing-header-inner">
        <a class="landing-brand" href={`${sectionPrefix}#top`}>Christopher Bengtsson</a>
        <p class="landing-availability">{t.availability}</p>
        <nav class="landing-section-nav" aria-label={locale === 'sv' ? 'Sektioner' : 'Sections'}>
          <ul>
            <li><a href={`${sectionPrefix}#services`}>{locale === 'sv' ? 'Kompetens' : 'What I do'}</a></li>
            <li><a href={`${sectionPrefix}#experience`}>{locale === 'sv' ? 'Erfarenhet' : 'Experience'}</a></li>
            <li><a href={`${sectionPrefix}#contact`}>{locale === 'sv' ? 'Kontakt' : 'Contact'}</a></li>
          </ul>
        </nav>
        <nav aria-label={locale === 'sv' ? 'Språk' : 'Language'} class="landing-language">
          <details>
            <summary aria-label={locale === 'sv' ? 'Välj språk. Nuvarande språk: svenska.' : 'Choose language. Current language: English.'}>{locale.toUpperCase()}<svg aria-hidden="true" viewBox="0 0 12 12" fill="none"><path d="m2.5 4.5 3.5 3 3.5-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></summary>
            <ul>
              <li><a href={pagePath('sv')} lang="sv" hreflang="sv" aria-current={locale === 'sv' ? 'page' : undefined}>Svenska</a></li>
              <li><a href={pagePath('en')} lang="en" hreflang="en" aria-current={locale === 'en' ? 'page' : undefined}>English</a></li>
            </ul>
          </details>
        </nav>
      </div>
      <div class="landing-scene"><LampThemeToggle label={t.themeToggleLabel} /></div>
    </header>
    <main id="main" class="landing-main"><slot /></main>
    <footer class="landing-footer">
      <div class="landing-wrap">
        <p>Christopher Bengtsson · {t.footer}</p>
        <nav aria-label={locale === 'sv' ? 'Profiler och integritet' : 'Profiles and privacy'}>
          <ul>
            {profiles.map((profile) => <li><a href={profile.url} rel="me">{profile.name}</a></li>)}
            <li><a href={privacyPath(locale)}>{t.privacy.title}</a></li>
          </ul>
        </nav>
      </div>
    </footer>
    <script>
      import { LampMotionUtil } from '../util/LampMotionUtil';
      import { createThemePalette, type Theme } from '../lib/theme-palette';
      import { SiteAnimationUtil } from '../util/SiteAnimationUtil';

      SiteAnimationUtil.initSiteInteractions();

      const root = document.documentElement;
      const button = document.querySelector<HTMLButtonElement>('button[data-lamp-toggle]');

      if (button) {
        const media = matchMedia('(prefers-color-scheme: dark)');
        let explicit: Theme | null = null;
        try {
          const saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') explicit = saved;
        } catch { /* A choice still works for this page when storage is blocked. */ }

        let theme: Theme = root.dataset.theme === 'dark' ? 'dark' : 'light';
        const palette = createThemePalette(root);
        const render = (next: Theme, animate = false) => {
          theme = next;
          palette.apply(next, animate);
          button.setAttribute('aria-pressed', String(next === 'dark'));
        };

        const motion = LampMotionUtil.initLampMotion(button, () => theme, (next: Theme) => {
          explicit = next;
          try { localStorage.setItem('theme', next); } catch { /* Keep the in-page choice. */ }
          render(next, true);
        });

        render(explicit ?? (media.matches ? 'dark' : 'light'));
        motion.sync();
        button.hidden = false;

        media.addEventListener('change', () => {
          if (explicit) return;
          render(media.matches ? 'dark' : 'light', true);
          motion.sync();
        });
        window.addEventListener('storage', (event) => {
          if (event.key !== 'theme' && event.key !== null) return;
          explicit = event.newValue === 'dark' || event.newValue === 'light' ? event.newValue : null;
          render(explicit ?? (media.matches ? 'dark' : 'light'), true);
          motion.sync();
        });
      }
    </script>
  </body>
</html>
